# ===========================================
# Terraform .gitignore
# ===========================================

# Local .terraform directories (plugin cache)
**/.terraform/*
**/.terraform/
.terraform/


# Terraform lock file (optional: keep if you want reproducible provider versions)
# .terraform.lock.hcl

# Terraform state files — NEVER commit these (contain sensitive data)
*.tfstate
*.tfstate.*
*.tfstate.backup

# Terraform plan output files
*.tfplan
*.plan

# Crash log files
crash.log
crash.*.log

# Override files (used for local overrides, not meant for version control)
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform variable files that may contain secrets
*.tfvars
*.tfvars.json
# Exception: keep example/template tfvars
!terraform.tfvars.example
!*.tfvars.example

# Terraform CLI configuration
.terraformrc
terraform.rc

# ===========================================
# AWS Credentials & Config — CRITICAL
# ===========================================
.aws/
*.pem
*.key
*credentials*
*secret*

# ===========================================
# IDE & OS files
# ===========================================

# VS Code
.vscode/
*.code-workspace

# JetBrains (IntelliJ, PyCharm, etc.)
.idea/

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~

# ===========================================
# Logs & temp files
# ===========================================
*.log
*.tmp
*.bak
tmp/
temp/
